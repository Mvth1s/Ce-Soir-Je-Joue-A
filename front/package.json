    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12"
  }
}
