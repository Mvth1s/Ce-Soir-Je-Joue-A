# Steam Web API (clé perso : https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Mistral API (tier gratuit : https://console.mistral.ai)
MISTRAL_API_KEY=

# SteamGridDB (https://www.steamgriddb.com/profile/preferences/api)
STEAMGRIDDB_API_KEY=

# Secret de signature de la session (iron-session), 32 caractères minimum.
SESSION_SECRET=

# Connexion Postgres (ex : Vercel Postgres / Neon)
DATABASE_URL=

# Health-check (scripts/healthcheck.ts) uniquement, optionnels. Timeout de
# chaque tentative vers Neon en ms (defaut 15000, couvre un reveil a froid),
# et nombre de nouvelles tentatives apres la premiere (defaut 2, soit 3
# tentatives au total ; seules les erreurs transitoires sont retentees).
# DATABASE_TIMEOUT_MS=15000
# DATABASE_RETRIES=2

# URL publique du site, utilisée pour construire l'URL de retour Steam OpenID.
PUBLIC_BASE_URL=http://localhost:5173

# Google Analytics 4 (identifiant de mesure, ex. G-XXXXXXXXXX). Voir README
# pour la procédure de création d'une propriété GA4. Optionnel : si vide, le
# script gtag.js n'est jamais chargé (front/src/lib/analytics.ts). Utilisé
# côté front (Vite), doit donc garder le préfixe VITE_.
VITE_GA_MEASUREMENT_ID=
