# Steam Web API (clé perso : https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Mistral API (tier gratuit : https://console.mistral.ai)
MISTRAL_API_KEY=

# SteamGridDB (https://www.steamgriddb.com/profile/preferences/api)
STEAMGRIDDB_API_KEY=

# Secret de signature de la session (iron-session), 32 caractères minimum.
SESSION_SECRET=

# Connexion Postgres (ex : Vercel Postgres / Neon)
DATABASE_URL=

# URL publique du site, utilisée pour construire l'URL de retour Steam OpenID.
PUBLIC_BASE_URL=http://localhost:5173
