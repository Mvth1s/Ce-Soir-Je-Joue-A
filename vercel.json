{
  "buildCommand": "pnpm --filter front build",
  "outputDirectory": "front/dist",
  "installCommand": "pnpm install",
  "devCommand": "pnpm --filter front dev --port $PORT",
  "rewrites": [
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales/index.html" },
    { "source": "/changelog", "destination": "/changelog/index.html" },
    { "source": "/((?!api/).*)", "destination": "/spa.html" }
  ]
}
